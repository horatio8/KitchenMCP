# Port to bind the MCP HTTP server on
PORT=3000

# Comma-separated list of HTTP Origins permitted to call the MCP endpoint.
# In production, set this to your AI client's origin(s). "*" is allowed for
# permissive setups, but origin checks help guard against DNS rebinding.
ALLOWED_ORIGINS=https://claude.ai,https://chat.openai.com

# Optional shared bearer token required to access the MCP endpoint itself.
# When set, clients MUST send `Authorization: Bearer <MCP_GATE_TOKEN>` (or
# the X-MCP-Auth header) IN ADDITION to per-tenant Kitchen credentials.
# Leave empty to disable (NOT recommended for public deployments).
MCP_GATE_TOKEN=

# Optional fallback Kitchen credentials used only if the client does not
# pass them via headers. Useful for single-tenant deployments. Leave empty
# in multi-tenant hosted mode.
KITCHEN_API_KEY=
KITCHEN_WORKSPACE=

# Request rate-limit: max requests / minute / IP at the HTTP edge.
HTTP_RATE_LIMIT_PER_MINUTE=120

# Trust X-Forwarded-* headers (set to 1 when behind a proxy/load balancer).
TRUST_PROXY=1

# Pino log level (trace, debug, info, warn, error)
LOG_LEVEL=info

# ===========================
# Webhook receiver (optional)
# ===========================
# Comma-separated list of webhook secrets — one per Kitchen webhook you
# register. The receiver tries each in constant time so you can support
# multiple workspaces or rotate secrets without downtime. Leave empty to
# disable the /webhooks/kitchen endpoint.
KITCHEN_WEBHOOK_SECRETS=

# Optional: forward verified events (POST JSON) to a downstream service.
# Use this when your real business logic lives elsewhere and this
# server is acting as a verifying ingress.
KITCHEN_WEBHOOK_FORWARD_URL=

# Optional: sent as `X-Forward-Token` on the forward POST so the
# downstream service can authenticate the relay.
KITCHEN_WEBHOOK_FORWARD_TOKEN=
